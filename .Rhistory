# Load necessary libraries
library(shiny)
library(vcfR)
library(seqinr)
library(ape)
library(ggplot2)
library(plotly)
library(adegenet)
library(poppr)
library(phangorn)
library(gaston)
library(dplyr)
library(shinyjs)
# Define server logic for Shiny app
shinyServer(function(input, output, session) {
# Use shinyjs to handle loading state
useShinyjs()
# Define a function to toggle the loading state
loadingState <- function(show) {
if (show) {
shinyjs::show("loading-content")
} else {shinyjs::hide("loading-content") }
}
# Reactive expression for loading the VCF file
vcfData <- reactive({
inFile <- input$vcfFile
if (is.null(inFile))
return(NULL)
vcfR::read.vcfR(inFile$datapath)
})
# Function to calculate allele frequencies
calculate_allele_frequencies <- function(vcf) {
gt <- extract.gt(vcf)
alleles <- matrix(unlist(strsplit(gt, "[/|]")), ncol = ncol(gt), byrow = FALSE)
allele_freqs <- apply(alleles, 2, function(x) table(factor(x, levels = c("0", "1"))) / length(x))
return(allele_freqs)
}
# Function to calculate heterozygosity
calculate_heterozygosity <- function(vcf) {
gt <- extract.gt(vcf)
heterozygosity <- apply(gt, 2, function(x) sum(x != "0/0" & x != "1/1")) / length(x)
return(heterozygosity)
}
# Function to calculate linkage disequilibrium
calculate_ld <- function(vcf) {
gt <- extract.gt(vcf)
numeric_gt <- apply(gt, 2, function(x) as.numeric(gsub("[/|]", "", x)))
ld_result <- LD(numeric_gt, depth = 2, cores = 1)
return(ld_result)
}
# Function for phylogenetic tree construction
build_phylogenetic_tree <- function(vcf) {
genind_obj <- vcfR2genind(vcf)
d <- dist.dna(as.DNAbin(as.character(genind_obj)), model="raw")
tree <- nj(d)
return(tree)
}
# Function for ancestral state reconstruction using parsimony
reconstruct_ancestral_states <- function(tree, vcf) {
genind_obj <- vcfR2genind(vcf)
phyDat_obj <- as.phyDat(genind_obj, type = "USER", levels = c("0/0", "0/1", "1/1"))
fit <- optim.parsimony(tree, phyDat_obj)
ancestral_states <- ancestral.pars(tree, phyDat_obj)
return(list(fit = fit, ancestral_states = ancestral_states))
}
# Function for genome comparison (calculating genetic distances)
calculate_genetic_distances <- function(vcf1, vcf2) {
# Convert VCF data to numeric matrices
gt1 <- apply(extract.gt(vcf1), 2, function(x) as.numeric(gsub("[/|]", "", x)))
gt2 <- apply(extract.gt(vcf2), 2, function(x) as.numeric(gsub("[/|]", "", x)))
# Calculate genetic distance using Euclidean distance
distance_matrix <- dist(rbind(t(gt1), t(gt2)), method = "euclidean")
return(distance_matrix)
}
# Function to identify shared genomic regions (simplified example)
identify_shared_regions <- function(vcf1, vcf2) {
# Extract SNP positions from both VCF files
pos1 <- getPOS(vcf1)
pos2 <- getPOS(vcf2)
# Find common positions
shared_positions <- intersect(pos1, pos2)
return(shared_positions)
}
# Reactive expression for VCF analysis
vcfAnalysis <- reactive({
if (is.null(vcfData()))
return(NULL)
vcf <- vcfData()
dp <- extract.gt(vcf, element = "DP")
dp_numeric <- as.numeric(dp)
allele_freqs <- calculate_allele_frequencies(vcf)
heterozygosity <- calculate_heterozygosity(vcf)
ld <- calculate_ld(vcf)
tree <- build_phylogenetic_tree(vcf)
ancestral_states <- reconstruct_ancestral_states(tree, vcf)
return(list(
depth = dp_numeric[!is.na(dp_numeric)],
allele_freqs = allele_freqs,
heterozygosity = heterozygosity,
ld = ld,
tree = tree,
ancestral_states = ancestral_states
))
})
# Reactive expression for comparing two genomes
genomeComparison <- reactive({
inFile1 <- input$vcfFile1
inFile2 <- input$vcfFile2
if (is.null(inFile1) || is.null(inFile2)) {
return(NULL)
}
vcf1 <- read.vcfR(inFile1$datapath)
vcf2 <- read.vcfR(inFile2$datapath)
distance_matrix <- calculate_genetic_distances(vcf1, vcf2)
shared_regions <- identify_shared_regions(vcf1, vcf2)
return(list(
distances = distance_matrix,
shared_regions = shared_regions
))
})
# Render basic statistics
# Render basic statistics
output$stats <- renderPrint({
loadingState(TRUE)
on.exit(loadingState(FALSE))
# Simulate some processing time
Sys.sleep(2)
if (is.null(vcfData())) {
return("Upload VCF to see statistics")
}
tryCatch({
summary(vcfAnalysis()$depth)
}, error = function(e) {
print(e)
return("Error calculating statistics")
})
})
# Render histogram of depth distribution
output$depthPlot <- renderPlot({
if (is.null(vcfAnalysis()))
return(NULL)
hist(vcfAnalysis()$depth, breaks = 50, col = 'skyblue', border = 'white', main = 'Depth Distribution', xlab = 'Depth')
})
# Render allele frequencies
output$alleleFreqTable <- renderTable({
if (is.null(vcfAnalysis()))
return(NULL)
as.data.frame(vcfAnalysis()$allele_freqs)
})
# Render heterozygosity
output$heterozygosityPlot <- renderPlot({
if (is.null(vcfAnalysis()))
return(NULL)
barplot(vcfAnalysis()$heterozygosity, main = "Heterozygosity", ylab = "Proportion", col = 'lightgreen')
})
# Render linkage disequilibrium
output$ldPlot <- renderPlot({
if (is.null(vcfAnalysis()))
return(NULL)
ld_data <- vcfAnalysis()$ld
heatmap(ld_data$r2, Rowv = NA, Colv = NA, main = "Linkage Disequilibrium (r^2)", col = heat.colors(12))
})
# Render phylogenetic tree
output$phylogeneticTree <- renderPlot({
if (is.null(vcfAnalysis())) return(NULL)
plot(vcfAnalysis()$tree, type = "phylogram", main = "Phylogenetic Tree")
})
# Render genetic distances
output$geneticDistances <- renderPrint({
if (is.null(genomeComparison())) return("Upload two VCF files to compare")
genomeComparison()$distances
})
# Render shared genomic regions
output$sharedRegions <- renderPrint({
if (is.null(genomeComparison())) return("Upload two VCF files to compare")
genomeComparison()$shared_regions
})
#Render visualization of differences between genome
output$genomeComparisonPlot <- renderPlotly({
if (is.null(genomeComparison())) {
return(NULL)
}
# Simplified visualization of genetic distance matrix
distance_matrix <- as.matrix(genomeComparison()$distances)
fig <- plot_ly(z = ~distance_matrix, type = "heatmap") %>%
layout(title = "Genetic Distances Heatmap")
# Convert the plotly object to a static plot if needed
# fig <- ggplotly(fig, dynamicTicks = TRUE)
fig
})
# Reactive expression for sequence data
sequenceData <- reactive({
inFile <- input$fastaFile
if (is.null(inFile))
return(NULL)
seqinr::read.fasta(inFile$datapath, seqtype = "DNA")
})
# Render sequence properties
output$seqSummary <- renderPrint({
seqs <- sequenceData()
if (is.null(seqs))
return("Upload FASTA to see sequence properties")
lapply(seqs, function(x) summary(x))
})
})
q()
